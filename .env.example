# ==============================================================================
# BOOST MARKET ENVIRONMENT CONFIGURATION SCHEMA (.env.example)
# ==============================================================================
# SECURITY INVARIANTS:
# 1. Never commit real credentials or secret keys to version control.
# 2. Server-only secrets MUST NEVER be prefixed with NEXT_PUBLIC_.
# 3. Only variables explicitly safe for user browser inspection use NEXT_PUBLIC_.
# ==============================================================================

# ==============================================================================
# SECTION A: PUBLIC CLIENT CONFIGURATION (Browser-Safe via NEXT_PUBLIC_)
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="YOUR_PAYSTACK_PUBLIC_KEY"
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY="YOUR_FLUTTERWAVE_PUBLIC_KEY"

# ==============================================================================
# SECTION B: SERVER-ONLY SECRETS & BACKEND CONFIGURATION (NEVER EXPOSE TO BROWSER)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & PORTS
# ------------------------------------------------------------------------------
NODE_ENV="development"                  # development | test | production
APP_NAME="Boost Market"
PORT=3000                              # Next.js frontend port
API_PORT=3001                          # NestJS orchestration backend port
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# ------------------------------------------------------------------------------
# 2. PERSISTENCE & CACHE (PostgreSQL & Redis)
# ------------------------------------------------------------------------------
# Required in production. In development, defaults to local PostgreSQL instance.
DATABASE_URL="postgresql://boost_user:boost_password@localhost:5432/boost_market_dev?schema=public"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL="false"

# Redis cache and background queue (BullMQ)
REDIS_URL="redis://localhost:6379"
REDIS_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# 3. AI PROVIDERS (Provider-Agnostic Engine)
# ------------------------------------------------------------------------------
# Default provider to activate ("gemini" | "openai" | "mock")
AI_DEFAULT_PROVIDER="gemini"

# Google Gemini API key (Server-side proxy only)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# OpenAI API key (Server-side reasoning adapter only)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SESSIONS
# ------------------------------------------------------------------------------
# Required in production (minimum 32 characters)
JWT_SECRET="development_jwt_secret_must_be_at_least_32_characters_long_for_security"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="development_session_secret_for_cookie_signing"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAYS (Server-Side Secrets)
# ------------------------------------------------------------------------------
PAYMENT_DEFAULT_PROVIDER="paystack"     # "paystack" | "flutterwave" | "mock"

# Paystack Server Secret Key (Debits, charge authorization, webhook validation)
PAYSTACK_SECRET_KEY="YOUR_PAYSTACK_SECRET_KEY"

# Flutterwave Server Secret Key
FLUTTERWAVE_SECRET_KEY="YOUR_FLUTTERWAVE_SECRET_KEY"

# ------------------------------------------------------------------------------
# 6. ADVERTISING CHANNELS (External Ad Network Distribution)
# ------------------------------------------------------------------------------
# Meta Graph API (Facebook & Instagram Ad Accounts)
META_APP_ID="YOUR_META_APP_ID"
META_APP_SECRET="YOUR_META_APP_SECRET"

# Google Ads API (Search & YouTube Campaigns)
GOOGLE_ADS_DEVELOPER_TOKEN="YOUR_GOOGLE_ADS_DEVELOPER_TOKEN"
GOOGLE_ADS_CLIENT_ID="YOUR_GOOGLE_ADS_CLIENT_ID"
GOOGLE_ADS_CLIENT_SECRET="YOUR_GOOGLE_ADS_CLIENT_SECRET"

# ------------------------------------------------------------------------------
# 7. OBJECT STORAGE (Campaign Assets & Flyers)
# ------------------------------------------------------------------------------
STORAGE_DRIVER="local"                  # "local" | "gcs" | "s3"
STORAGE_BUCKET_NAME="boost-market-assets-dev"

# ------------------------------------------------------------------------------
# 8. EMAIL & NOTIFICATIONS
# ------------------------------------------------------------------------------
EMAIL_DRIVER="smtp"                     # "smtp" | "resend" | "mock"
EMAIL_FROM="no-reply@boostmarket.ng"

# ------------------------------------------------------------------------------
# 9. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
LOG_LEVEL="info"                        # "debug" | "info" | "warn" | "error"
OTEL_ENABLED="false"
